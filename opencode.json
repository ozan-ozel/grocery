{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",

      ".dev.vars": "deny",
      ".dev.vars*": "deny",

      "secrets/**": "deny",
      "secret/**": "deny",
      "**/secrets/**": "deny",
      "**/secret/**": "deny",

      "**/*credentials*": "deny",
      "**/*credential*": "deny",

      "**/*password*": "deny",
      "**/*passwd*": "deny",

      "**/*token*": "deny",
      "**/*private-key*": "deny",
      "**/*private_key*": "deny"
    },

    "edit": "deny",

    "bash": {
      "git push *": "deny",
      "git remote *": "deny",

      "rm *": "deny",
      "rmdir *": "deny",

      "del *": "deny",
      "erase *": "deny",

      "format *": "deny",

      "*Set-Content*": "deny",
      "*Add-Content*": "deny",
      "*Out-File*": "deny",
      "*New-Item*": "deny",
      "*tee *": "deny",
      "* > *": "deny",
      "* >> *": "deny",

      "*curl*": "deny",
      "*wget*": "deny",
      "*Invoke-WebRequest*": "deny",
      "*Invoke-RestMethod*": "deny",
      "*iwr *": "deny",

      "*": "ask"
    },

    "task": "ask",

    "skill": "ask",

    "webfetch": "ask",

    "websearch": "ask",

    "external_directory": "deny",

    "question": "allow",

    "glob": "allow",

    "grep": "allow",

    "lsp": "allow"
  }
}
