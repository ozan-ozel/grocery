{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",
      "Bash(type .env*)",
      "Bash(Get-Content .env*)",
      "Bash(more .env*)",
      "Bash(less .env*)"
    ]
  }
}
