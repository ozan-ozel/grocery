{
  "skills": [
    "current-state-update",
    "session-log"
  ],
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run agent-session -- up)",
      "Bash(npm run agent-session -- down)",
      "Bash(npm run agent-session -- status)",
      "Bash(timeout 15 npm run vercel:dev)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",
      "Bash(type .env*)",
      "Bash(Get-Content .env*)",
      "Bash(more .env*)",
      "Bash(less .env*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Bash(npm run agent-mint *)",
      "Bash(node scripts/agent-mint.mjs*)",
      "Bash(node --env-file*)",
      "Bash(vercel env pull*)",
      "Bash(npx vercel env pull*)"
    ]
  }
}
