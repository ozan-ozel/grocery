# Vercel CLI deploys the local filesystem and doesn't reliably inherit
# .gitignore here, so mirror the excludes that matter for deploy size/content.

node_modules
dist
*.tsbuildinfo
.env
.env.local
.env.*.local
.serena
.claude
.superpowers

# Not part of the deployed app; contains copyrighted source textbooks up to
# 600+MB, well over Vercel's 100MB per-file limit.
nutrition-curriculum

# Retired code kept for possible restoration (see archive/README.md). Never built
# or imported, so it has no business in a deploy.
archive

# Dev-only testing endpoints, kept out of prod to stay within the 12-function Hobby limit.
# NOTE: `vercel dev` honors this file too, so while these lines are active the endpoints are
# NOT served locally either. Do not hand-edit them for a browser session: `npm run agent-session -- up`
# comments out the agent-login line temporarily and `-- down` restores it (see docs/operations.md,
# section ".vercelignore"). Both lines must be live, with no temporary marker left behind, BEFORE
# any `npm run deploy` / `deploy:prod`.
api/agent-login.ts
api/_auth-test-login.ts
